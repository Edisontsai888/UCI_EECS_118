    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python 偵錯工具: 目前檔案",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
	        "name": "D.L2.DFS.TinyMaze",
	        "type": "debugpy",
	        "request": "launch",
	        "program": "${workspaceFolder}/catman.py",
	        "console": "integratedTerminal",
	        "justMyCode": false,
	        "stopOnEntry": false,
	        "cwd": "${workspaceFolder}/p1_search",
	        "args": [
		            "-l", "tinyMaze",
		            "-p", "SearchAgent",
		            "-a", "fn=depthFirstSearch",
                    "--frameTime", "0.5"
	]
}
    ]
}